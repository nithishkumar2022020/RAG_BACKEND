GEMINI_GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUESTS_PER_MINUTE=30
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_DIMENSION=768
